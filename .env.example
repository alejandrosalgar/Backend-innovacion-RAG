# API
# Orígenes CORS extra (coma-separados). En Render/producción incluye tu Hosting Firebase, p. ej.:
# PMDI_CORS_ORIGINS=https://innovacion-demo.web.app,https://innovacion-demo.firebaseapp.com
PMDI_CORS_ORIGINS=

PMDI_API_HOST=127.0.0.1
PMDI_API_PORT=8080
PMDI_API_RELOAD=0

# Proveedores (local-first)
# Opciones: chroma | azure_ai_search
PMDI_VECTOR_PROVIDER=chroma
# Opciones: local | azure_openai
# local = respuestas en ~100 ms, SIN ChatGPT/GPT (solo plantilla + búsqueda en Chroma).
# azure_openai = redacción con GPT vía Azure (latencia típica 2–15 s).
PMDI_LLM_PROVIDER=local

# Local embeddings + Chroma
PMDI_CHROMA_PATH=./data/chroma
PMDI_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
PMDI_WARMUP_ON_START=1
PMDI_QUERY_VARIANTS=0
PMDI_RETRIEVAL_N_RESULTS=8
PMDI_MIN_RETRIEVAL_SCORE=0.58
PMDI_MIN_VECTOR_SCORE=0.48
PMDI_RETRIEVAL_FALLBACK=1

# Azure OpenAI (activar cuando migres)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Azure AI Search (activar cuando migres)
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=
